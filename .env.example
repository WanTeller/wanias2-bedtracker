# Copy this to  .env  in the project root (git-ignored) and edit as needed.
# Every line here is optional in development - the app has sensible defaults.
# config/settings.py loads this file automatically.

# --- TESTING MODE -------------------------------------------------------- #
# true  = login page asks only for a name (no email/password/signup).
# false = the real email + password signup & login flow.
# Flip this any time; existing users and data are unaffected.
BEDTRACKER_SIMPLE_LOGIN=false

# --- security (set these for real hosting) ----------------------------- #
# BEDTRACKER_SECRET_KEY=<a long random string>
# BEDTRACKER_DEBUG=false
# BEDTRACKER_ALLOWED_HOSTS=bedtracker.example.com

# --- database (default = local SQLite) ------------------------------- #
# BEDTRACKER_DB=postgres
# BEDTRACKER_DB_NAME=bedtracker
# BEDTRACKER_DB_USER=bedtracker
# BEDTRACKER_DB_PASSWORD=<password>
# BEDTRACKER_DB_HOST=localhost
# BEDTRACKER_DB_PORT=5432

# --- password-reset email (default = printed to the console) --------- #
# BEDTRACKER_EMAIL_HOST=smtp.gmail.com
# BEDTRACKER_EMAIL_PORT=587
# BEDTRACKER_EMAIL_USER=you@gmail.com
# BEDTRACKER_EMAIL_PASSWORD=<gmail app password>

# --- developer "clear all patient data" button --------------------- #
# BEDTRACKER_DEV_CLEAR_PASSWORD=clear-ward
