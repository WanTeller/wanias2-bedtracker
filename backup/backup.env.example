# Copy this file to  backup.env  (same folder) and edit as needed.
# backup.env is git-ignored. Do NOT put a database password in here.

# --- which database -------------------------------------------------------- #
# "sqlite" during development, "postgres" once the app is hosted.
DB_KIND=sqlite

# --- SQLite (development) ------------------------------------------------- #
# Defaults to ..\db.sqlite3 next to this project. Only set if it moved.
# SQLITE_PATH=C:\Users\Hassan\Desktop\WanTeller\Projects\BedTracker\db.sqlite3

# --- PostgreSQL (once the app is hosted) ------------------------------- #
# Get these from the Neon dashboard -> your project -> "Connection Details".
# Use the DIRECT (non-pooled) host for pg_dump - it usually looks like
#   ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech   (NOT the "-pooler" one).
# DB_KIND=postgres
# PG_HOST=ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech
# PG_PORT=5432
# PG_DB=neondb
# PG_USER=neondb_owner
# PG_SSLMODE=require
#
# Password: NEVER put it here. Put it in  %APPDATA%\postgresql\pgpass.conf
# as ONE line (create the folder/file if missing):
#   ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech:5432:neondb:neondb_owner:THEPASSWORD
#
# pg_dump / pg_restore must be on PATH, or point at them:
# PG_DUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_RESTORE=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe

# --- where backups go --------------------------------------------------- #
BACKUP_DIR=C:\Users\Hassan\Desktop\WanTeller\Projects\BedTracker\backup

# --- when to run ------------------------------------------------------- #
# Weekday: Mon=0 Tue=1 Wed=2 Thu=3 Fri=4 Sat=5 Sun=6.  Leave blank for any day.
RUN_WEEKDAY=6
# Skip if there is no internet connection (matters once the DB is hosted).
REQUIRE_INTERNET=true
# Don't bother dumping again if the last backup was less than this many minutes
# ago (a new file is only kept anyway if the data changed).
MIN_INTERVAL_MINUTES=90

# --- how many to keep ------------------------------------------------ #
# Keep every backup from the last N days...
RETENTION_DAYS=14
# ...then one per ISO week for a further N weeks.
RETENTION_WEEKS=8
